{
  "name": "@goreecloud/plugin",
  "version": "0.1.0-dev",
  "private": true,
  "type": "module",
  "description": "GoreeCloud-owned bounded MCP / OpenAI Apps SDK integration foundation.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "tsx mcp/server/src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "lint": "node scripts/lint.mjs",
    "validate:repository": "node scripts/validate-repository.mjs",
    "check": "npm run validate:repository && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.0.1",
    "@modelcontextprotocol/sdk": "1.24.0",
    "express": "5.1.0",
    "zod": "3.25.0"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.20.1",
    "tsx": "4.19.2",
    "typescript": "5.9.2"
  }
}
